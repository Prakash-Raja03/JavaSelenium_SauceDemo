<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Runs only tests tagged with the "smoke" group.
     Run with: mvn test -DsuiteXmlFile=src/test/resources/suites/smoke.xml -->
<suite name="SmokeSuite" verbose="1">
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.prakash.automation.tests.LoginTest"/>
            <class name="com.prakash.automation.tests.ProductsTest"/>
        </classes>
    </test>
</suite>
