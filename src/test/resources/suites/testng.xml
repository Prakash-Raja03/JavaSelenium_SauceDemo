<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  TestNG suite.
   - parallel="methods" + thread-count runs tests concurrently
     (safe here because DriverFactory uses ThreadLocal<WebDriver>).
   - thread-count is intentionally 1 for resource-constrained CI agents
     (e.g. sandboxed containers) where multiple concurrent headless Chrome
     instances exhaust memory and cause UnreachableBrowserException.
     Raise it to 2+ on a larger agent to exercise true parallelism.
   - Run everything:            mvn test
   - Run only smoke tests:      mvn test -Dgroups=smoke
-->
<suite name="RegressionSuite" parallel="methods" thread-count="1" verbose="1">

    <test name="SauceDemo UI Tests">
        <classes>
            <class name="com.prakash.automation.tests.LoginTest"/>
            <class name="com.prakash.automation.tests.ProductsTest"/>
        </classes>
    </test>

</suite>
