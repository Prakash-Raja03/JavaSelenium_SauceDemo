<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  TestNG suite.
   - parallel="methods" + thread-count runs tests concurrently
     (safe here because DriverFactory uses ThreadLocal<WebDriver>).
   - Run everything:            mvn test
   - Run only smoke tests:      mvn test -Dgroups=smoke
-->
<suite name="RegressionSuite" parallel="methods" thread-count="2" verbose="1">

    <test name="SauceDemo UI Tests">
        <classes>
            <class name="com.prakash.automation.tests.LoginTest"/>
            <class name="com.prakash.automation.tests.ProductsTest"/>
        </classes>
    </test>

</suite>
